    value: 10.5281/zenodo.24090287
    description: All versions (each release has its own DOI on Zenodo)
repository-code: "https://github.com/rkrug/zotero-backup"
url: "https://rkrug.github.io/zotero-backup/"
license: MIT
keywords:
  - Zotero
  - backup
  - restore
  - reference management
  - bibliography
  - citations
  - Zotero web API
  - command-line tool
  - Go
